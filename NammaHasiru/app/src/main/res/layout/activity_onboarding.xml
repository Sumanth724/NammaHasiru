<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF7ED"
    tools:context=".OnboardingActivity">

    <!-- ── Floating leaves background ───────────────────────────── -->
    <com.nammahasiru.app.FloatingLeavesView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- ── Outer ring ─────────────────────────────────────── -->
    <View
        android:id="@+id/ringOuter"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:background="@drawable/bg_onboard_circle"
        android:alpha="0.22"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/onboardingTitle"
        app:layout_constraintVertical_bias="0.5"/>

    <!-- ── Middle ring ────────────────────────────────────── -->
    <View
        android:id="@+id/ringMiddle"
        android:layout_width="162dp"
        android:layout_height="162dp"
        android:background="@drawable/bg_onboard_circle"
        android:alpha="0.45"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ringOuter"
        app:layout_constraintBottom_toBottomOf="@id/ringOuter"/>

    <!-- ── Inner icon circle ──────────────────────────────── -->
    <FrameLayout
        android:id="@+id/iconCircle"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:background="@drawable/bg_onboard_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ringOuter"
        app:layout_constraintBottom_toBottomOf="@id/ringOuter">

        <ImageView
            android:id="@+id/onboardingIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_onboard_plant"
            android:contentDescription="Onboarding icon" />
    </FrameLayout>

    <!-- ── Title ──────────────────────────────────────────── -->
    <TextView
        android:id="@+id/onboardingTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="40dp"
        android:layout_marginTop="36dp"
        android:gravity="center"
        android:text="Track every plant you grow"
        android:textColor="#1B5E20"
        android:textSize="22sp"
        android:textStyle="bold"
        android:lineSpacingExtra="4dp"
        app:layout_constraintTop_toBottomOf="@id/ringOuter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Description ───────────────────────────────────── -->
    <TextView
        android:id="@+id/onboardingDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:text="Photo + GPS tag each sapling. Know exactly where every plant lives in your village."
        android:textColor="#4A7040"
        android:textSize="14sp"
        android:lineSpacingExtra="5dp"
        app:layout_constraintTop_toBottomOf="@id/onboardingTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ── Page dots ─────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/dotsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <View android:id="@+id/dot1"
            android:layout_width="24dp" android:layout_height="8dp"
            android:background="@drawable/bg_onboard_dot_active"
            android:layout_marginEnd="6dp"/>

        <View android:id="@+id/dot2"
            android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/bg_onboard_dot_inactive"
            android:layout_marginEnd="6dp"/>

        <View android:id="@+id/dot3"
            android:layout_width="8dp" android:layout_height="8dp"
            android:background="@drawable/bg_onboard_dot_inactive"/>
    </LinearLayout>

    <!-- ── Bottom row: Next + Skip ───────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Push Next to right side -->
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>

        <!-- Next button — white outlined pill -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingHorizontal="28dp"
            android:text="Next →"
            android:textColor="#1B5E20"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@android:color/white"
            app:strokeColor="#1B5E20"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp"
            app:elevation="0dp"/>

        <!-- Skip text -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="Skip"
            android:textColor="#4A7040"
            android:textSize="15sp"
            android:padding="8dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
