<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Legend strip only — no header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_color"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🟢 Alive" android:textSize="12sp" android:textColor="@color/status_alive"
            android:textStyle="bold" android:layout_marginEnd="16dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔴 Lost" android:textSize="12sp" android:textColor="@color/status_dead"
            android:textStyle="bold" android:layout_marginEnd="16dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🟡 Pending" android:textSize="12sp" android:textColor="@color/status_unknown"
            android:textStyle="bold" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

        <TextView
            android:id="@+id/tv_map_plant_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 plants"
            android:textSize="11sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Google Map fills the rest of the screen -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map_fragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
