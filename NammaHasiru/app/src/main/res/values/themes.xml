<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NammaHasiru" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/green_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/green_100</item>
        <item name="colorOnPrimaryContainer">@color/green_900</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/earth_amber</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/green_50</item>
        <item name="colorOnSecondaryContainer">@color/green_800</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/green_800</item>
        <!-- Navigation bar color. -->
        <item name="android:navigationBarColor">@color/surface_color</item>

        <!-- Background and surface colors. -->
        <item name="android:windowBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_primary</item>
    </style>

    <!-- Splash: full screen, no action bar -->
    <style name="Theme.NammaHasiru.Splash" parent="Theme.NammaHasiru">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/green_800</item>
    </style>

    <style name="CircularFAB" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">50%</item>
    </style>

</resources>
