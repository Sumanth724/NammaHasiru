<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.nammahasiru.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_addPlant"
            app:destination="@id/addPlantFragment" />
        <action
            android:id="@+id/action_home_to_plantList"
            app:destination="@id/plantListFragment" />
        <action
            android:id="@+id/action_home_to_plantDetail"
            app:destination="@id/plantDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/plantListFragment"
        android:name="com.nammahasiru.app.ui.home.PlantListFragment"
        android:label="Plant List"
        tools:layout="@layout/fragment_plant_list">
        <argument
            android:name="filterType"
            app:argType="string"
            android:defaultValue="ALL" />
    </fragment>

    <fragment
        android:id="@+id/addPlantFragment"
        android:name="com.nammahasiru.app.ui.addplant.AddPlantFragment"
        android:label="Add Plant"
        tools:layout="@layout/fragment_add_plant">
        <action
            android:id="@+id/action_addPlant_to_success"
            app:destination="@id/addPlantSuccessFragment"
            app:popUpTo="@id/addPlantFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/addPlantSuccessFragment"
        android:name="com.nammahasiru.app.ui.addplant.AddPlantSuccessFragment"
        android:label="Plant Saved"
        tools:layout="@layout/fragment_add_plant_success">
        <argument
            android:name="speciesName"
            app:argType="string" />
        <argument
            android:name="latitude"
            app:argType="float" />
        <argument
            android:name="longitude"
            app:argType="float" />
    </fragment>

    <fragment
        android:id="@+id/mapFragment"
        android:name="com.nammahasiru.app.ui.map.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/statsFragment"
        android:name="com.nammahasiru.app.ui.stats.StatsFragment"
        android:label="Stats"
        tools:layout="@layout/fragment_stats" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.nammahasiru.app.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.nammahasiru.app.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.nammahasiru.app.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/plantDetailFragment"
        android:name="com.nammahasiru.app.ui.home.PlantDetailFragment"
        android:label="Plant Detail"
        tools:layout="@layout/fragment_plant_detail">
        <argument
            android:name="plantId"
            app:argType="integer"
            android:defaultValue="-1" />
    </fragment>

</navigation>
